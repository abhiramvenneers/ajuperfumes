                        class="w-full pl-9 pr-8 py-2.5 text-xs bg-stone-50 border border-stone-200 rounded-full focus:outline-none focus:border-black focus:bg-white transition-all shadow-2xs"
                    >
                    <svg class="w-4 h-4 text-stone-400 absolute left-3 top-1/2 -translate-y-1/2 pointer-events-none" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path></svg>
                    <button x-show="searchQuery" @click="searchQuery = ''" style="display: none;" class="absolute right-2.5 top-1/2 -translate-y-1/2 text-stone-400 hover:text-black p-1">
                        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>
                    </button>
                </div>

                <!-- Category Chips: Horizontally Scrollable on Mobile -->
                <div class="flex items-center gap-2 overflow-x-auto no-scrollbar py-1 -mx-4 px-4 sm:mx-0 sm:px-0 whitespace-nowrap text-xs font-medium">
                    <button @click="filter = 'All'; window.location.hash = 'shop'" 
                            :class="filter === 'All' ? 'bg-black text-white shadow-md scale-105' : 'bg-stone-100 text-stone-700 hover:bg-stone-200'" 
                            class="px-4 py-2 sm:px-5 sm:py-2.5 rounded-full uppercase text-[9px] sm:text-[10px] tracking-wider transition-all duration-200 font-bold shrink-0 active:scale-95 touch-callout-none">
                        All
                    </button>
                    
                    {rawCategories.map(cat => (
                        <button @click={`filter = '${cat}'; window.location.hash = '${cat.toLowerCase()}'`} 
                                :class={`filter === '${cat}' ? 'bg-black text-white shadow-md scale-105' : 'bg-stone-100 text-stone-700 hover:bg-stone-200'`} 
                                class="px-4 py-2 sm:px-5 sm:py-2.5 rounded-full uppercase text-[9px] sm:text-[10px] tracking-wider transition-all duration-200 font-bold shrink-0 active:scale-95 touch-callout-none">
                            {cat === 'Accessories' ? 'Tech & Accessories' : (cat + ' Perfumes')}
                        </button>
                    ))}
                </div>
            </div>
        </div>

        <!-- Catalog Product Grid (2 Columns on Mobile with Closer Gaps) -->
        <div class="grid grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-x-3 gap-y-6 sm:gap-x-6 sm:gap-y-12">
            
            {(products || []).map((product) => {
                const rawCategory = product.category || 'Classic';
                const categoryNormalized = rawCategory.toString().trim().charAt(0).toUpperCase() + rawCategory.toString().trim().slice(1).toLowerCase();
                const isAccessory = categoryNormalized.toLowerCase().includes('access');
                
                const imageUrl = product.image_url ? String(product.image_url).split(',')[0].trim() : '';
                const productName = product.name || 'Premium Item';
                
                const dbVariants = product.product_variants || [];
                const hasVariants = dbVariants.length > 0;
                
                const defaultVariant = hasVariants ? dbVariants[0] : { id: null, variant_label: 'Standard', price_override: 0, stock_quantity: 0 };
                const variantsJson = JSON.stringify(dbVariants).replace(/'/g, "\\'");

                const safeName = escapeAttr(productName);
                const safeImageUrl = escapeAttr(imageUrl);
                const safeNotes = escapeAttr(product.notes || '');

                return (
                    <div 
                        class="group flex flex-col bg-white border border-stone-200/80 hover:border-stone-400 p-2.5 sm:p-4 transition-all duration-300 rounded-xs shadow-2xs hover:shadow-xl"
                        x-show={`isMatch('${categoryNormalized}', '${safeName}', '${safeNotes}')`}
                        x-data={`{
                            variants: ${variantsJson},
                            selectedVariantId: '${defaultVariant.id || ""}',
                            selectedLabel: '${defaultVariant.variant_label}',
                            currentPrice: ${defaultVariant.price_override || 0},
                            currentStock: ${defaultVariant.stock_quantity || 0},
                            updateVariant(vId) {
                                const found = this.variants.find(v => v.id === vId);
                                if (found) {
                                    this.selectedVariantId = found.id;
                                    this.selectedLabel = found.variant_label;
                                    this.currentPrice = found.price_override;
                                    this.currentStock = found.stock_quantity;
                                }
                            }
                        }`}
                        x-transition:enter="transition ease-out duration-300 transform"
                        x-transition:enter-start="opacity-0 translate-y-4 scale-95"
                        x-transition:enter-end="opacity-100 translate-y-0 scale-100"
                    >
                        <!-- Image Container -->
                        <div class="aspect-[3/4] w-full bg-[#f8f7f4] relative mb-2.5 sm:mb-4 overflow-hidden flex items-center justify-center rounded-2xs group/img">
                            <a href={`/product/${product.id}`} class="absolute inset-0 z-10"></a>

                            <span class={`absolute top-2 left-2 sm:top-3 sm:left-3 text-[7px] sm:text-[8px] font-bold uppercase tracking-wider px-1.5 py-0.5 sm:px-2.5 sm:py-1 border z-20 rounded-2xs shadow-2xs ${isAccessory ? 'bg-sky-50 text-sky-800 border-sky-200' : 'bg-amber-50 text-amber-800 border-amber-200'}`}>
                                {isAccessory ? 'Accessory' : 'Fragrance'}
                            </span>

                            <span x-show="currentStock <= 0" class="absolute top-2 right-2 sm:top-3 sm:right-3 bg-red-600 text-white px-1.5 py-0.5 sm:px-2.5 sm:py-1 text-[7px] sm:text-[8px] font-bold uppercase tracking-wider z-20 rounded-2xs">Sold Out</span>

                            {imageUrl ? (
                                <img 
                                    src={imageUrl} 
                                    alt={productName} 
                                    class="w-full h-full object-cover transition-transform duration-700 ease-out group-hover/img:scale-108"
                                    onerror="this.style.display='none'; this.nextElementSibling.style.display='block';"
                                />
                            ) : null}
                            
                            <span class={`font-serif italic text-xl sm:text-2xl text-stone-300 px-2 text-center group-hover/img:scale-105 transition-transform duration-500 ${imageUrl ? 'hidden' : 'block'}`}>
                                {productName.split(' ')[0]}
                            </span>
                        </div>

                        <!-- Product Metadata -->
                        <div class="flex-grow flex flex-col justify-between">
                            <div>
                                <a href={`/product/${product.id}`} class="block font-serif text-sm sm:text-lg font-medium text-stone-900 mb-0.5 hover:underline truncate">
                                    {productName}
                                </a>
                                
                                <!-- Variant Selector -->
                                <template x-if="variants.length > 1">
                                    <div class="flex flex-wrap gap-1 my-1.5 sm:my-2.5">
                                        <template x-for="v in variants" :key="v.id">
                                            <button 
                                                type="button"
                                                @click="updateVariant(v.id)"
                                                :class="selectedVariantId === v.id ? 'bg-stone-900 text-white border-stone-900' : 'bg-white text-stone-600 border-stone-200 hover:border-stone-900'"
                                                class="px-2 py-0.5 text-[7px] sm:text-[8px] font-bold uppercase border rounded-2xs transition-all duration-200"
                                                x-text="v.variant_label"
                                            ></button>
                                        </template>
                                    </div>
                                </template>

                                <template x-if="variants.length <= 1">
                                    <div class="text-[8px] sm:text-[9px] font-mono text-stone-400 uppercase tracking-wider mb-1 sm:mb-2">
                                        <span x-text="selectedLabel"></span>
                                    </div>
                                </template>
                            </div>
                            
                            <!-- Bottom Row -->
                            <div class="mt-2 sm:mt-4 pt-2.5 sm:pt-3 border-t border-stone-100 flex items-center justify-between gap-1">
                                <span class="font-serif font-medium text-sm sm:text-base text-stone-900" x-text="'₹' + Number(currentPrice).toLocaleString('en-IN')"></span>

                                <button 
                                    @click={`$store.cart.add({ id: '${product.id}', variant_id: selectedVariantId, name: '${safeName}', price: currentPrice, volume: selectedLabel, image_url: '${safeImageUrl}' })`}
                                    :disabled="currentStock <= 0"
                                    class="px-2.5 py-1.5 sm:px-4 sm:py-2 uppercase text-[8px] sm:text-[9px] font-bold tracking-wider rounded-2xs transition-all duration-200 border active:scale-95 touch-callout-none"
                                    :class="currentStock <= 0 ? 'bg-stone-50 text-stone-300 border-stone-200 cursor-not-allowed' : 'bg-black text-white border-black hover:bg-stone-800'"
                                >
                                    <span x-show="currentStock <= 0">Out</span>
                                    <span x-show="currentStock > 0">+ Add</span>
                                </button>
                            </div>
                        </div>
                    </div>
                );
            })}
            
            <!-- Empty State / No Search or Filter Results -->
            <div x-show="!hasMatches" style="display: none;" class="col-span-full py-10 sm:py-20 px-2 text-center">
                <div class="max-w-md mx-auto bg-stone-50/80 border border-stone-200/80 rounded-sm p-6 sm:p-12 shadow-2xs">
                    
                    <div class="w-12 h-12 sm:w-14 sm:h-14 bg-white border border-stone-200 rounded-full flex items-center justify-center mx-auto mb-4 text-stone-400 shadow-2xs">
                        <svg class="w-5 h-5 sm:w-6 sm:h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
                        </svg>
                    </div>

                    <template x-if="searchQuery">
                        <div>
                            <h3 class="font-serif text-lg sm:text-2xl font-medium text-stone-900 mb-2">No matching items</h3>
                            <p class="text-xs text-stone-500 font-light leading-relaxed mb-6 px-2">
                                We couldn't find any products matching "<span class="font-semibold text-stone-900" x-text="searchQuery"></span>" 
                                <span x-show="filter !== 'All'" x-text="'in ' + filter"></span>.
                            </p>
                            <div class="flex flex-col sm:flex-row gap-2.5 justify-center">
                                <button 
                                    @click="searchQuery = ''" 
                                    class="bg-black text-white text-[9px] sm:text-[10px] font-bold uppercase tracking-[0.2em] px-5 py-3 rounded-2xs hover:bg-stone-800 transition-colors shadow-sm"
                                >
                                    Clear Search
                                </button>
                                <button 
                                    @click="searchQuery = ''; filter = 'All'; window.location.hash = 'shop'" 
                                    class="border border-stone-300 text-stone-800 text-[9px] sm:text-[10px] font-bold uppercase tracking-[0.2em] px-5 py-3 rounded-2xs hover:border-black transition-colors"
                                >
                                    Show All Products
                                </button>
                            </div>
                        </div>
                    </template>

                    <template x-if="!searchQuery">
                        <div>
                            <h3 class="font-serif text-lg sm:text-2xl font-medium text-stone-900 mb-2">Collection Empty</h3>
                            <p class="text-xs text-stone-500 font-light leading-relaxed mb-6">
                                There are currently no items available in this category.
                            </p>
                            <button 
                                @click="filter = 'All'; window.location.hash = 'shop'" 
                                class="bg-black text-white text-[9px] sm:text-[10px] font-bold uppercase tracking-[0.2em] px-5 py-3 rounded-2xs hover:bg-stone-800 transition-colors shadow-sm"
                            >
                                View All Products
                            </button>
                        </div>
                    </template>

                </div>
            </div>

        </div>
    </section>

    <!-- GUARANTEES & CLIENT ASSURANCE BAR -->
    <section class="bg-stone-50 border-t border-stone-200/80 py-12 sm:py-16 px-4 sm:px-6 lg:px-12">
        <div class="max-w-[1400px] mx-auto grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6 sm:gap-8">
            
            <div class="flex items-start gap-3.5">
                <div class="w-9 h-9 sm:w-10 sm:h-10 rounded-full bg-white border border-stone-200 flex items-center justify-center text-stone-800 shrink-0 text-sm sm:text-base">
                    🚚
                </div>
                <div>
                    <h4 class="font-serif font-medium text-stone-900 text-sm sm:text-base">Complimentary Shipping</h4>
                    <p class="text-xs text-stone-500 font-light mt-0.5 leading-relaxed">Free standard courier dispatch across India on all prepaid purchases.</p>
                </div>
            </div>

            <div class="flex items-start gap-3.5">
                <div class="w-9 h-9 sm:w-10 sm:h-10 rounded-full bg-white border border-stone-200 flex items-center justify-center text-stone-800 shrink-0 text-sm sm:text-base">
                    📦
                </div>
                <div>
                    <h4 class="font-serif font-medium text-stone-900 text-sm sm:text-base">DTDC Courier Network</h4>
                    <p class="text-xs text-stone-500 font-light mt-0.5 leading-relaxed">Dispatched within 24 to 48 hours with digital consignment tracking.</p>
                </div>
            </div>

            <div class="flex items-start gap-3.5">
                <div class="w-9 h-9 sm:w-10 sm:h-10 rounded-full bg-white border border-stone-200 flex items-center justify-center text-stone-800 shrink-0 text-sm sm:text-base">
                    🔒
                </div>
                <div>
                    <h4 class="font-serif font-medium text-stone-900 text-sm sm:text-base">Secure Razorpay Gateway</h4>
                    <p class="text-xs text-stone-500 font-light mt-0.5 leading-relaxed">1-Tap UPI (GPay, PhonePe, Paytm), Debit/Credit Cards & Netbanking.</p>
                </div>
            </div>

            <div class="flex items-start gap-3.5">
                <div class="w-9 h-9 sm:w-10 sm:h-10 rounded-full bg-white border border-stone-200 flex items-center justify-center text-stone-800 shrink-0 text-sm sm:text-base">
                    💬
                </div>
                <div>
                    <h4 class="font-serif font-medium text-stone-900 text-sm sm:text-base">Direct Concierge Care</h4>
                    <p class="text-xs text-stone-500 font-light mt-0.5 leading-relaxed">Questions? Reach out on WhatsApp (+91 8075304432) anytime.</p>
                </div>
            </div>

        </div>
    </section>

</Layout>
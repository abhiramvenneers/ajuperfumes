    <!-- FULL MASTER CATALOG SECTION WITH SEARCH & CATEGORY TRANSITIONS -->
    <section id="shop" class="py-20 sm:py-28 px-6 lg:px-12 max-w-[1400px] mx-auto" 
             x-data={sectionXData} 
             x-init="
                const updateFilter = () => {
                    const hash = window.location.hash.substring(1).toLowerCase().trim();
                    if (!hash || hash === 'shop' || hash === 'all') {
                        filter = 'All';
                        return;
                    }
                    
                    const matchedCat = categories.find(cat => cat.toLowerCase().trim() === hash);
                    if (matchedCat) {
                        filter = matchedCat;
                    } else if (hash === 'fragrances') {
                        filter = 'Classic';
                    } else if (hash === 'accessories') {
                        filter = 'Accessories';
                    } else {
                        filter = 'All';
                    }

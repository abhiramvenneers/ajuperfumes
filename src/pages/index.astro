---
import Layout from '../layouts/Layout.astro';
import { supabase } from '../lib/supabase.js';

// Securely pull Products alongside their nested product_variants relational array
const { data: products, error } = await supabase
  .from('products')
  .select('*, product_variants(*)')
  .order('created_at', { ascending: false });

if (error) console.error('Error fetching inventory catalog:', error.message);

// Dynamically generate unique categories sorted alphabetically
const rawCategories = Array.from(new Set((products || []).map(p => {
    const cat = (p.category || 'Classic').trim();
    return cat.charAt(0).toUpperCase() + cat.slice(1).toLowerCase();
}))).sort();

const categoryList = rawCategories.map(c => `'${c}'`).join(', ');

const escapeAttr = (str) => {
    if (!str) return '';
    return String(str)
        .replace(/\\/g, "\\\\")
        .replace(/'/g, "\\'")
        .replace(/"/g, "&quot;")
        .replace(/\r?\n|\r/g, " ");
};

const itemsForSearch = (products || []).map(p => {
    const cat = (p.category || 'Classic').trim();
    const categoryNormalized = cat.charAt(0).toUpperCase() + cat.slice(1).toLowerCase();
    return {
        cat: categoryNormalized,
        name: escapeAttr(p.name || ''),
        notes: escapeAttr(p.notes || '')
    };
});

const itemsJson = JSON.stringify(itemsForSearch);

const sectionXData = `{
    filter: 'All', 
    searchQuery: '', 
    categories: [${categoryList}],
    items: ${itemsJson},
    isMatch(cat, name, notes) {
        const q = (this.searchQuery || '').toLowerCase().trim();
        const f = this.filter;
        const catMatch = f === 'All' || f === cat || (f === 'Fragrances' && (cat === 'Classic' || cat === 'Premium'));
        if (!catMatch) return false;
        if (!q) return true;
        return name.toLowerCase().includes(q) || cat.toLowerCase().includes(q) || notes.toLowerCase().includes(q);
    },
    get hasMatches() {
        return (this.items || []).some(i => this.isMatch(i.cat, i.name, i.notes));
    }
}`;

// Select top 6 products as featured gallery sliding entries
const sliderProducts = (products || []).slice(0, 6);

                updateFilter();
                window.addEventListener('hashchange', updateFilter);
             ">
        
        <div class="flex flex-col lg:flex-row justify-between items-start lg:items-center mb-12 border-b border-stone-200 pb-8 gap-6">
            <div>
                <span class="text-[10px] text-stone-400 font-bold uppercase tracking-widest block mb-1">Catalog Overview</span>
                <h2 class="text-3xl sm:text-4xl md:text-5xl font-serif font-medium text-stone-900">Master Collection</h2>
            </div>
            
            <!-- Search & Filter Bar Controls -->
            <div class="flex flex-col sm:flex-row items-stretch sm:items-center gap-4 w-full lg:w-auto">
                
                <!-- Search Input Field -->
                <div class="relative min-w-[240px] sm:w-64">
                    <input 
                        type="text" 
                        x-model="searchQuery" 
                        placeholder="Search products..." 
                        class="w-full pl-10 pr-9 py-2.5 text-xs bg-stone-50 border border-stone-200 rounded-full focus:outline-none focus:border-black focus:bg-white transition-all shadow-2xs"
                    >
                    <svg class="w-4 h-4 text-stone-400 absolute left-3.5 top-1/2 -translate-y-1/2 pointer-events-none" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path></svg>

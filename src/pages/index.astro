                const rawCategory = product.category || 'Classic';
                const categoryNormalized = rawCategory.toString().trim().charAt(0).toUpperCase() + rawCategory.toString().trim().slice(1).toLowerCase();
                const isAccessory = categoryNormalized.toLowerCase().includes('access');
                
                const imageUrl = product.image_url ? String(product.image_url).split(',')[0].trim() : '';
                const productName = product.name || 'Premium Item';
                
                const dbVariants = product.product_variants || [];
                const hasVariants = dbVariants.length > 0;
                
                const defaultVariant = hasVariants ? dbVariants[0] : { id: null, variant_label: 'Standard', price_override: 0, stock_quantity: 0 };
                const variantsJson = JSON.stringify(dbVariants).replace(/'/g, "\\'");

                const safeName = escapeAttr(productName);
                const safeImageUrl = escapeAttr(imageUrl);
                const safeNotes = escapeAttr(product.notes || '');

                let xShow = `((filter === 'All' || filter === '${categoryNormalized}' || (filter === 'Fragrances' && ('${categoryNormalized}' === 'Classic' || '${categoryNormalized}' === 'Premium'))) && ('${safeName}'.toLowerCase().includes(searchQuery.toLowerCase().trim()) || '${categoryNormalized}'.toLowerCase().includes(searchQuery.toLowerCase().trim()) || '${safeNotes}'.toLowerCase().includes(searchQuery.toLowerCase().trim())))`;

                return (
                    <div 
                        class="group flex flex-col bg-white border border-stone-200/80 hover:border-stone-400 p-4 transition-all duration-500 rounded-xs shadow-2xs hover:shadow-xl hover:-translate-y-1.5"
                        x-show={xShow}
                        x-data={`{
                            variants: ${variantsJson},
                            selectedVariantId: '${defaultVariant.id || ""}',
                            selectedLabel: '${defaultVariant.variant_label}',
                            currentPrice: ${defaultVariant.price_override || 0},
                            currentStock: ${defaultVariant.stock_quantity || 0},
                            updateVariant(vId) {
                                const found = this.variants.find(v => v.id === vId);
                                if (found) {
                                    this.selectedVariantId = found.id;
                                    this.selectedLabel = found.variant_label;
                                    this.currentPrice = found.price_override;
                                    this.currentStock = found.stock_quantity;
                                }
                            }
                        }`}
                        x-transition:enter="transition ease-out duration-500 transform"
                        x-transition:enter-start="opacity-0 translate-y-6 scale-95"
                        x-transition:enter-end="opacity-100 translate-y-0 scale-100"
                    >
                        <!-- Image Container with Zoom -->
                        <div class="aspect-[3/4] w-full bg-[#f8f7f4] relative mb-4 overflow-hidden flex items-center justify-center rounded-2xs group/img">
                            <a href={`/product/${product.id}`} class="absolute inset-0 z-10"></a>

                            <span class={`absolute top-3 left-3 text-[8px] font-bold uppercase tracking-wider px-2.5 py-1 border z-20 rounded-2xs shadow-2xs ${isAccessory ? 'bg-sky-50 text-sky-800 border-sky-200' : 'bg-amber-50 text-amber-800 border-amber-200'}`}>
                                {isAccessory ? 'Accessory' : 'Fragrance'}
                            </span>

                            <span x-show="currentStock <= 0" class="absolute top-3 right-3 bg-red-600 text-white px-2.5 py-1 text-[8px] font-bold uppercase tracking-wider z-20 rounded-2xs">Sold Out</span>

                            {imageUrl ? (
                                <img 
                                    src={imageUrl} 
                                    alt={productName} 
                                    class="w-full h-full object-cover transition-transform duration-700 ease-out group-hover/img:scale-108"
                                    onerror="this.style.display='none'; this.nextElementSibling.style.display='block';"
                                />
                            ) : null}
                            
                            <span class={`font-serif italic text-2xl text-stone-300 px-4 text-center group-hover/img:scale-105 transition-transform duration-500 ${imageUrl ? 'hidden' : 'block'}`}>
                                {productName.split(' ')[0]}
                            </span>
                        </div>

                        <!-- Product Metadata -->
                        <div class="flex-grow flex flex-col justify-between">
                            <div>
                                <a href={`/product/${product.id}`} class="block font-serif text-lg font-medium text-stone-900 mb-1 hover:underline truncate">
                                    {productName}
                                </a>
                                
                                <!-- Variant Selector -->
                                <template x-if="variants.length > 1">
                                    <div class="flex flex-wrap gap-1.5 my-2.5">
                                        <template x-for="v in variants" :key="v.id">
                                            <button 
                                                type="button"
                                                @click="updateVariant(v.id)"
                                                :class="selectedVariantId === v.id ? 'bg-stone-900 text-white border-stone-900 scale-105' : 'bg-white text-stone-600 border-stone-200 hover:border-stone-900'"
                                                class="px-2.5 py-1 text-[8px] font-bold uppercase border rounded-2xs transition-all duration-200"
                                                x-text="v.variant_label"
                                            ></button>
                                        </template>
                                    </div>
                                </template>

                                <template x-if="variants.length <= 1">
                                    <div class="text-[9px] font-mono text-stone-400 uppercase tracking-wider mb-2">
                                        <span x-text="selectedLabel"></span>
                                    </div>
                                </template>
                            </div>
                            
                            <!-- Bottom Row -->
                            <div class="mt-4 pt-3 border-t border-stone-100 flex items-center justify-between gap-2">
                                <span class="font-serif font-medium text-base text-stone-900" x-text="'₹' + Number(currentPrice).toLocaleString('en-IN')"></span>

                                <button 
                                    @click={`$store.cart.add({ id: '${product.id}', variant_id: selectedVariantId, name: '${safeName}', price: currentPrice, volume: selectedLabel, image_url: '${safeImageUrl}' })`}
                                    :disabled="currentStock <= 0"
                                    class="px-4 py-2 uppercase text-[9px] font-bold tracking-wider rounded-2xs transition-all duration-300 border active:scale-95"
                                    :class="currentStock <= 0 ? 'bg-stone-50 text-stone-300 border-stone-200 cursor-not-allowed' : 'bg-black text-white border-black hover:bg-stone-800 hover:shadow-md'"
                                >
                                    <span x-show="currentStock <= 0">Out</span>
                                    <span x-show="currentStock > 0">+ Add</span>
                                </button>
                            </div>
                        </div>
                    </div>
                );
            })}
            
            <!-- Empty State / No Search Results -->
            <div x-show="!categories.some(cat => filter === 'All' || (filter === 'Fragrances' && (cat === 'Classic' || cat === 'Premium')) || cat === filter)" style="display: none;" class="col-span-full py-16 text-center text-stone-400 font-serif italic text-base">
                <p x-show="!searchQuery">No items currently found in this category.</p>
                <div x-show="searchQuery" style="display: none;" class="space-y-3">
                    <p>No products matching "<span class="font-sans not-italic text-stone-900 font-semibold" x-text="searchQuery"></span>"</p>
                    <button @click="searchQuery = ''; filter = 'All'; window.location.hash = 'shop'" class="inline-block text-xs font-mono uppercase tracking-widest text-black underline font-bold hover:text-stone-600 transition-colors">Clear Search & View All</button>
                </div>
            </div>

        </div>
    </section>

    <!-- GUARANTEES & CLIENT ASSURANCE BAR -->
    <section class="bg-stone-50 border-t border-stone-200/80 py-16 px-6 lg:px-12">
        <div class="max-w-[1400px] mx-auto grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-8">
            
            <div class="flex items-start gap-4 group">
                <div class="w-10 h-10 rounded-full bg-white border border-stone-200 flex items-center justify-center text-stone-800 shrink-0 group-hover:scale-110 group-hover:border-black transition-all">
                    🚚
                </div>
                <div>
                    <h4 class="font-serif font-medium text-stone-900 text-base">Complimentary Shipping</h4>
                    <p class="text-xs text-stone-500 font-light mt-1 leading-relaxed">Free standard courier dispatch across India on all prepaid purchases.</p>
                </div>
            </div>

            <div class="flex items-start gap-4 group">
                <div class="w-10 h-10 rounded-full bg-white border border-stone-200 flex items-center justify-center text-stone-800 shrink-0 group-hover:scale-110 group-hover:border-black transition-all">
                    📦
                </div>
                <div>
                    <h4 class="font-serif font-medium text-stone-900 text-base">DTDC Courier Network</h4>
                    <p class="text-xs text-stone-500 font-light mt-1 leading-relaxed">Dispatched within 24 to 48 hours with digital consignment tracking.</p>
                </div>
            </div>

            <div class="flex items-start gap-4 group">
                <div class="w-10 h-10 rounded-full bg-white border border-stone-200 flex items-center justify-center text-stone-800 shrink-0 group-hover:scale-110 group-hover:border-black transition-all">
                    🔒
                </div>
                <div>
                    <h4 class="font-serif font-medium text-stone-900 text-base">Secure Razorpay Gateway</h4>
                    <p class="text-xs text-stone-500 font-light mt-1 leading-relaxed">1-Tap UPI (GPay, PhonePe, Paytm), Debit/Credit Cards & Netbanking.</p>
                </div>
            </div>

            <div class="flex items-start gap-4 group">
                <div class="w-10 h-10 rounded-full bg-white border border-stone-200 flex items-center justify-center text-stone-800 shrink-0 group-hover:scale-110 group-hover:border-black transition-all">
                    💬
                </div>
                <div>
                    <h4 class="font-serif font-medium text-stone-900 text-base">Direct Concierge Care</h4>
                    <p class="text-xs text-stone-500 font-light mt-1 leading-relaxed">Questions? Reach out on WhatsApp (+91 8075304432) anytime.</p>
                </div>
            </div>

        </div>
    </section>

</Layout>
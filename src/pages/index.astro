---
import Layout from '../layouts/Layout.astro';
import { supabase } from '../lib/supabase.js';

// Securely pull Products alongside their nested product_variants relational array
const { data: products, error } = await supabase
  .from('products')
  .select('*, product_variants(*)')
  .order('created_at', { ascending: false });

if (error) console.error('Error fetching inventory catalog:', error.message);

// Dynamically generate unique categories sorted alphabetically
const rawCategories = Array.from(new Set((products || []).map(p => {
    const cat = (p.category || 'Classic').trim();
    return cat.charAt(0).toUpperCase() + cat.slice(1).toLowerCase();
}))).sort();

const categoryList = rawCategories.map(c => `'${c}'`).join(', ');
const sectionXData = `{ filter: 'All', categories: [${categoryList}] }`;

// Select top 6 products as featured gallery sliding entries
const sliderProducts = (products || []).slice(0, 6);

const escapeAttr = (str) => {
    if (!str) return '';
    return String(str).replace(/'/g, "\\'").replace(/"/g, "&quot;");
};
---

<Layout title="Aju | Fine Fragrances & Modern Essentials">
    
    <!-- Self-Healing Local Storage Script -->
    <script is:inline>
        (function() {
            try {
                const stored = localStorage.getItem('cartItems');
                if (stored) {
                    const parsed = JSON.parse(stored);
                    if (Array.isArray(parsed)) {
                        const needsUpgrade = parsed.some(item => !item.hasOwnProperty('variant_id'));
                        if (needsUpgrade) {
                            localStorage.removeItem('cartItems');
                        }
                    }
                }
            } catch (e) {
                localStorage.removeItem('cartItems');
            }
        })();
    </script>

    <!-- Ultra-Minimalist Hero Section -->
    <section class="relative bg-[#09090b] text-white pt-24 pb-20 md:pt-32 md:pb-28 px-6 overflow-hidden border-b border-neutral-900">
        <div class="max-w-4xl mx-auto text-center flex flex-col items-center">
            
            <span class="text-[10px] font-mono uppercase tracking-[0.35em] text-neutral-400 mb-6 block">
                Aju House Curation
            </span>
            
            <h1 class="text-4xl sm:text-6xl md:text-7xl font-serif font-light tracking-tight text-white mb-6 leading-[1.15]">
                Scents & <span class="italic font-normal text-neutral-300">Objects</span>
            </h1>
            
            <p class="text-xs sm:text-sm text-neutral-400 font-light max-w-md mx-auto leading-relaxed mb-10 tracking-wide">
                Hand-bottled fine perfumes and minimalist daily hardware. Thoughtfully designed for everyday ritual.
            </p>
            
            <!-- Sleek Minimal Link Pills -->
            <div class="flex flex-wrap items-center justify-center gap-4">
                <a href="#shop" @click="window.location.hash = 'classic'" class="bg-white text-black px-8 py-3.5 text-[10px] font-bold uppercase tracking-[0.2em] hover:bg-neutral-200 transition-colors rounded-xs shadow-sm">
                    Explore Perfumes
                </a>
                <a href="#shop" @click="window.location.hash = 'accessories'" class="border border-neutral-700 text-neutral-200 px-8 py-3.5 text-[10px] font-bold uppercase tracking-[0.2em] hover:border-white hover:text-white transition-all rounded-xs">
                    Explore Accessories
                </a>
            </div>

        </div>

        <!-- Minimal Department Divider Line -->
        <div class="max-w-5xl mx-auto mt-20 pt-10 border-t border-neutral-800/60 grid grid-cols-1 md:grid-cols-2 gap-6 text-left">
            
            <a href="#shop" @click="window.location.hash = 'classic'" class="group p-6 border border-neutral-800/80 hover:border-neutral-500 bg-neutral-950/50 transition-all flex justify-between items-center rounded-xs">
                <div>
                    <span class="text-[9px] font-mono text-neutral-400 tracking-widest uppercase block mb-1">01 / Collection</span>
                    <h3 class="font-serif text-lg text-white font-normal group-hover:translate-x-1 transition-transform">Artisanal Perfumery</h3>
                </div>
                <span class="text-neutral-400 group-hover:text-white transition-colors text-sm font-mono">→</span>
            </a>

            <a href="#shop" @click="window.location.hash = 'accessories'" class="group p-6 border border-neutral-800/80 hover:border-neutral-500 bg-neutral-950/50 transition-all flex justify-between items-center rounded-xs">
                <div>
                    <span class="text-[9px] font-mono text-neutral-400 tracking-widest uppercase block mb-1">02 / Collection</span>
                    <h3 class="font-serif text-lg text-white font-normal group-hover:translate-x-1 transition-transform">Tech & Essentials</h3>
                </div>
                <span class="text-neutral-400 group-hover:text-white transition-colors text-sm font-mono">→</span>
            </a>

        </div>
    </section>

    <!-- CURATED FEATURED SLIDER -->
    <section class="py-16 sm:py-24 bg-[#fafafa] border-b border-gray-100 overflow-hidden" 
             x-data="{
                scrollLeft() {
                    this.$refs.sliderContainer.scrollBy({ left: -300, behavior: 'smooth' });
                },
                scrollRight() {
                    const el = this.$refs.sliderContainer;
                    if (!el) return;
                    if (el.scrollLeft + el.clientWidth >= el.scrollWidth - 30) {
                        el.scrollTo({ left: 0, behavior: 'smooth' });
                    } else {
                        el.scrollBy({ left: 300, behavior: 'smooth' });
                    }
                }
             }">
        <div class="max-w-[1400px] mx-auto px-6 lg:px-12">
            
            <div class="flex justify-between items-end mb-10">
                <div>
                    <span class="text-[9px] font-mono text-gray-400 uppercase tracking-widest block mb-1">Selection</span>
                    <h2 class="text-2xl sm:text-3xl font-serif font-medium tracking-tight text-gray-900">Featured Curations</h2>
                </div>
                
                <div class="flex gap-2">
                    <button @click="scrollLeft()" class="w-10 h-10 border border-gray-200 bg-white flex items-center justify-center text-gray-600 hover:text-black hover:border-black transition-colors rounded-xs">
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M15 19l-7-7 7-7"></path></svg>
                    </button>
                    <button @click="scrollRight()" class="w-10 h-10 border border-gray-200 bg-white flex items-center justify-center text-gray-600 hover:text-black hover:border-black transition-colors rounded-xs">
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 5l7 7-7 7"></path></svg>
                    </button>
                </div>
            </div>

            <!-- Horizontal Slider Container -->
            <div x-ref="sliderContainer" class="flex gap-6 overflow-x-auto no-scrollbar snap-x snap-mandatory scroll-smooth pb-4">
                {sliderProducts.map((product) => {
                    const rawCategory = product.category || 'Classic';
                    const categoryNormalized = rawCategory.toString().trim().charAt(0).toUpperCase() + rawCategory.toString().trim().slice(1).toLowerCase();
                    const isAccessory = categoryNormalized.toLowerCase().includes('access');
                    
                    const imageUrl = product.image_url ? String(product.image_url).split(',')[0].trim() : '';
                    const productName = product.name || 'Premium Item';
                    
                    const dbVariants = product.product_variants || [];
                    const hasVariants = dbVariants.length > 0;
                    
                    const defaultVariant = hasVariants ? dbVariants[0] : { id: null, variant_label: 'Standard', price_override: 0, stock_quantity: 0 };
                    const variantsJson = JSON.stringify(dbVariants).replace(/'/g, "\\'");
                    
                    const safeName = escapeAttr(productName);
                    const safeImageUrl = escapeAttr(imageUrl);

                    return (
                        <div class="snap-start w-[260px] sm:w-[290px] shrink-0 bg-white border border-gray-100 p-4 hover:border-gray-300 transition-all duration-300 flex flex-col justify-between group rounded-xs"
                             x-data={`{
                                variants: ${variantsJson},
                                selectedVariantId: '${defaultVariant.id || ""}',
                                selectedLabel: '${defaultVariant.variant_label}',
                                currentPrice: ${defaultVariant.price_override || 0},
                                currentStock: ${defaultVariant.stock_quantity || 0},
                                updateVariant(vId) {
                                    const found = this.variants.find(v => v.id === vId);
                                    if (found) {
                                        this.selectedVariantId = found.id;
                                        this.selectedLabel = found.variant_label;
                                        this.currentPrice = found.price_override;
                                        this.currentStock = found.stock_quantity;
                                    }
                                }
                             }`}>
                            
                            <!-- Image Frame -->
                            <div class="aspect-[3/4] w-full bg-[#f6f6f6] relative mb-4 overflow-hidden flex items-center justify-center rounded-xs">
                                <a href={`/product/${product.id}`} class="absolute inset-0 z-10"></a>
                                
                                <span class="absolute top-2.5 left-2.5 text-[8px] font-mono uppercase tracking-widest px-2 py-0.5 border border-gray-200 bg-white text-gray-600 z-20">
                                    {isAccessory ? 'Accessory' : 'Fragrance'}
                                </span>

                                <span x-show="currentStock <= 0" class="absolute top-2.5 right-2.5 bg-black text-white px-2 py-0.5 text-[8px] font-mono uppercase tracking-widest z-20">Sold Out</span>

                                {imageUrl ? (
                                    <img src={imageUrl} alt={productName} class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-102" />
                                ) : (
                                    <span class="text-gray-300 font-serif italic text-lg px-4 text-center">{productName.split(' ')[0]}</span>
                                )}
                            </div>

                            <!-- Details -->
                            <div class="text-left flex-grow flex flex-col justify-between">
                                <div>
                                    <a href={`/product/${product.id}`} class="block font-serif text-base font-medium text-gray-900 truncate hover:underline mb-1">
                                        {productName}
                                    </a>
                                    
                                    <!-- Variant Selector -->
                                    <template x-if="variants.length > 1">
                                        <div class="flex flex-wrap gap-1 my-2">
                                            <template x-for="v in variants" :key="v.id">
                                                <button 
                                                    type="button"
                                                    @click="updateVariant(v.id)"
                                                    :class="selectedVariantId === v.id ? 'bg-black text-white border-black' : 'bg-white text-gray-500 border-gray-200 hover:border-black'"
                                                    class="px-2 py-1 text-[8px] font-mono uppercase border rounded-xs transition-all"
                                                    x-text="v.variant_label"
                                                ></button>
                                            </template>
                                        </div>
                                    </template>

                                    <template x-if="variants.length <= 1">
                                        <div class="text-[9px] font-mono text-gray-400 uppercase tracking-wider mb-2">
                                            <span x-text="selectedLabel"></span>
                                        </div>
                                    </template>
                                </div>

                                <div class="mt-3 pt-3 border-t border-gray-100 flex items-center justify-between gap-2">
                                    <span class="font-serif font-medium text-sm text-gray-900" x-text="'₹' + Number(currentPrice).toLocaleString('en-IN')"></span>

                                    <button 
                                        @click={`$store.cart.add({ id: '${product.id}', variant_id: selectedVariantId, name: '${safeName}', price: currentPrice, volume: selectedLabel, image_url: '${safeImageUrl}' })`}
                                        :disabled="currentStock <= 0"
                                        class="px-3 py-1.5 uppercase text-[9px] font-mono font-bold tracking-wider rounded-xs transition-colors border"
                                        :class="currentStock <= 0 ? 'bg-gray-50 text-gray-300 border-gray-200 cursor-not-allowed' : 'bg-black text-white border-black hover:bg-neutral-800'"
                                    >
                                        <span x-show="currentStock <= 0">Out</span>
                                        <span x-show="currentStock > 0">+ Add</span>
                                    </button>
                                </div>
                            </div>
                        </div>
                    );
                })}
            </div>
        </div>
    </section>

    <!-- FULL CATALOG SECTION -->
    <section id="shop" class="py-20 sm:py-28 px-6 max-w-[1400px] mx-auto" 
             x-data={sectionXData} 
             x-init="
                const updateFilter = () => {
                    const hash = window.location.hash.substring(1).toLowerCase().trim();
                    if (!hash || hash === 'shop' || hash === 'all') {
                        filter = 'All';
                        return;
                    }
                    
                    const matchedCat = categories.find(cat => cat.toLowerCase().trim() === hash);
                    if (matchedCat) {
                        filter = matchedCat;
                    } else if (hash === 'fragrances') {
                        filter = 'Classic';
                    } else if (hash === 'accessories') {
                        filter = 'Accessories';
                    } else {
                        filter = 'All';
                    }
                };
                updateFilter();
                window.addEventListener('hashchange', updateFilter);
             ">
        
        <div class="flex flex-col md:flex-row justify-between items-start md:items-end mb-12 border-b border-gray-200 pb-6 gap-6">
            <div>
                <span class="text-[9px] font-mono text-gray-400 uppercase tracking-widest block mb-1">Catalog</span>
                <h2 class="text-3xl sm:text-4xl font-serif font-light text-gray-900">All Objects</h2>
            </div>
            
            <!-- Category Tabs -->
            <div class="flex flex-wrap gap-4 text-xs font-mono uppercase tracking-wider">
                <button @click="filter = 'All'; window.location.hash = 'shop'" 
                        :class="filter === 'All' ? 'text-black border-b-2 border-black font-bold' : 'text-gray-400 hover:text-black'" 
                        class="pb-1 transition-colors">
                    All
                </button>
                
                {rawCategories.map(cat => (
                    <button @click={`filter = '${cat}'; window.location.hash = '${cat.toLowerCase()}'`} 
                            :class={`filter === '${cat}' ? 'text-black border-b-2 border-black font-bold' : 'text-gray-400 hover:text-black'`} 
                            class="pb-1 transition-colors">
                        {cat === 'Accessories' ? 'Tech & Accessories' : cat}
                    </button>
                ))}
            </div>
        </div>

        <div class="grid grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-x-6 gap-y-12">
            
            {(products || []).map((product) => {
                const rawCategory = product.category || 'Classic';
                const categoryNormalized = rawCategory.toString().trim().charAt(0).toUpperCase() + rawCategory.toString().trim().slice(1).toLowerCase();
                const isAccessory = categoryNormalized.toLowerCase().includes('access');
                
                const imageUrl = product.image_url ? String(product.image_url).split(',')[0].trim() : '';
                const productName = product.name || 'Premium Item';
                
                const dbVariants = product.product_variants || [];
                const hasVariants = dbVariants.length > 0;
                
                const defaultVariant = hasVariants ? dbVariants[0] : { id: null, variant_label: 'Standard', price_override: 0, stock_quantity: 0 };
                const variantsJson = JSON.stringify(dbVariants).replace(/'/g, "\\'");

                let xShow = `filter === 'All' || filter === '${categoryNormalized}' || (filter === 'Fragrances' && ('${categoryNormalized}' === 'Classic' || '${categoryNormalized}' === 'Premium'))`;

                const safeName = escapeAttr(productName);
                const safeImageUrl = escapeAttr(imageUrl);
                
                return (
                    <div 
                        class="group flex flex-col bg-white border border-transparent hover:border-gray-200 p-3 transition-all duration-300 rounded-xs"
                        x-show={xShow}
                        x-data={`{
                            variants: ${variantsJson},
                            selectedVariantId: '${defaultVariant.id || ""}',
                            selectedLabel: '${defaultVariant.variant_label}',
                            currentPrice: ${defaultVariant.price_override || 0},
                            currentStock: ${defaultVariant.stock_quantity || 0},
                            updateVariant(vId) {
                                const found = this.variants.find(v => v.id === vId);
                                if (found) {
                                    this.selectedVariantId = found.id;
                                    this.selectedLabel = found.variant_label;
                                    this.currentPrice = found.price_override;
                                    this.currentStock = found.stock_quantity;
                                }
                            }
                        }`}
                        x-transition:enter="transition-opacity duration-300"
                        x-transition:enter-start="opacity-0"
                        x-transition:enter-end="opacity-100"
                    >
                        <!-- Image Container -->
                        <div class="aspect-[3/4] w-full bg-[#f6f6f6] relative mb-4 overflow-hidden flex items-center justify-center rounded-xs">
                            <a href={`/product/${product.id}`} class="absolute inset-0 z-10"></a>

                            <span class="absolute top-2.5 left-2.5 text-[8px] font-mono uppercase tracking-widest px-2 py-0.5 border border-gray-200 bg-white text-gray-600 z-20">
                                {isAccessory ? 'Accessory' : 'Fragrance'}
                            </span>

                            <span x-show="currentStock <= 0" class="absolute top-2.5 right-2.5 bg-black text-white px-2 py-0.5 text-[8px] font-mono uppercase tracking-widest z-20">Sold Out</span>

                            {imageUrl ? (
                                <img 
                                    src={imageUrl} 
                                    alt={productName} 
                                    class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-102"
                                    onerror="this.style.display='none'; this.nextElementSibling.style.display='block';"
                                />
                            ) : null}
                            
                            <span class={`font-serif italic text-2xl text-gray-300 px-4 text-center ${imageUrl ? 'hidden' : 'block'}`}>
                                {productName.split(' ')[0]}
                            </span>
                        </div>

                        <!-- Product Metadata -->
                        <div class="flex-grow flex flex-col justify-between">
                            <div>
                                <a href={`/product/${product.id}`} class="block font-serif text-base sm:text-lg font-medium text-gray-900 mb-1 hover:underline truncate">
                                    {productName}
                                </a>
                                
                                <!-- Variant Selector -->
                                <template x-if="variants.length > 1">
                                    <div class="flex flex-wrap gap-1 my-2">
                                        <template x-for="v in variants" :key="v.id">
                                            <button 
                                                type="button"
                                                @click="updateVariant(v.id)"
                                                :class="selectedVariantId === v.id ? 'bg-black text-white border-black' : 'bg-white text-gray-500 border-gray-200 hover:border-black'"
                                                class="px-2 py-1 text-[8px] font-mono uppercase border rounded-xs transition-all"
                                                x-text="v.variant_label"
                                            ></button>
                                        </template>
                                    </div>
                                </template>

                                <template x-if="variants.length <= 1">
                                    <div class="text-[9px] font-mono text-gray-400 uppercase tracking-wider mb-2">
                                        <span x-text="selectedLabel"></span>
                                    </div>
                                </template>
                            </div>
                            
                            <!-- Bottom Row -->
                            <div class="mt-4 pt-3 border-t border-gray-100 flex items-center justify-between gap-2">
                                <span class="font-serif font-medium text-base text-gray-900" x-text="'₹' + Number(currentPrice).toLocaleString('en-IN')"></span>

                                <button 
                                    @click={`$store.cart.add({ id: '${product.id}', variant_id: selectedVariantId, name: '${safeName}', price: currentPrice, volume: selectedLabel, image_url: '${safeImageUrl}' })`}
                                    :disabled="currentStock <= 0"
                                    class="px-3.5 py-1.5 uppercase text-[9px] font-mono font-bold tracking-wider rounded-xs transition-colors border"
                                    :class="currentStock <= 0 ? 'bg-gray-50 text-gray-300 border-gray-200 cursor-not-allowed' : 'bg-black text-white border-black hover:bg-neutral-800'"
                                >
                                    <span x-show="currentStock <= 0">Out</span>
                                    <span x-show="currentStock > 0">+ Add</span>
                                </button>
                            </div>
                        </div>
                    </div>
                );
            })}
            
            <!-- Empty State -->
            <div x-show="!categories.some(cat => filter === 'All' || (filter === 'Fragrances' && (cat === 'Classic' || cat === 'Premium')) || cat === filter)" style="display: none;" class="col-span-full py-16 text-center text-gray-400 font-serif italic text-base">
                No items currently found in this category.
            </div>

        </div>
    </section>

</Layout>
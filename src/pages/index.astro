<Layout title="Aju | Signature Fragrances & Modern Tech Accessories">
    
    <!-- Custom CSS Animations for Marquee and Fade Transitions -->
    <style is:inline>
        @keyframes marquee {
            0% { transform: translateX(0%); }
            100% { transform: translateX(-50%); }
        }
        .animate-marquee-fast {
            display: flex;
            width: 200%;
            animation: marquee 18s linear infinite;
            will-change: transform;
        }
        .animate-marquee-slow {
            display: flex;
            width: 200%;
            animation: marquee 32s linear infinite;
            will-change: transform;
        }
        .animate-marquee-fast:hover, .animate-marquee-slow:hover {
            animation-play-state: paused;
        }

        @keyframes fadeInUp {
            from {
                opacity: 0;
                transform: translateY(18px);
            }
            to {
                opacity: 1;
                transform: translateY(0);
            }
        }
        .animate-appear {
            animation: fadeInUp 0.6s cubic-bezier(0.16, 1, 0.3, 1) forwards;
        }
        .delay-1 { animation-delay: 0.1s; }
        .delay-2 { animation-delay: 0.2s; }
        .delay-3 { animation-delay: 0.3s; }
        .delay-4 { animation-delay: 0.4s; }

        .touch-callout-none {
            touch-action: manipulation;
        }
    </style>

    <!-- Self-Healing Local Storage Script for returning browsers -->
    <script is:inline>

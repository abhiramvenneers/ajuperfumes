---
import Layout from '../layouts/Layout.astro';
import { supabase } from '../lib/supabase.js';

// Securely pull Products alongside their nested product_variants relational array
const { data: products, error } = await supabase
  .from('products')
  .select('*, product_variants(*)')
  .order('created_at', { ascending: false });

if (error) console.error('Error fetching inventory catalog:', error.message);

// Dynamically generate unique categories sorted alphabetically
const rawCategories = Array.from(new Set((products || []).map(p => {
    const cat = (p.category || 'Classic').trim();
    return cat.charAt(0).toUpperCase() + cat.slice(1).toLowerCase();
}))).sort();

const categoryList = rawCategories.map(c => `'${c}'`).join(', ');
const sectionXData = `{ filter: 'All', categories: [${categoryList}] }`;

// Select top 6 products as featured gallery sliding entries
const sliderProducts = (products || []).slice(0, 6);

const escapeAttr = (str) => {
    if (!str) return '';
    return String(str).replace(/'/g, "\\'").replace(/"/g, "&quot;");
};
---

<Layout title="Aju | Fine Fragrances & Modern Essentials">
    
    <!-- Self-Healing Local Storage Script -->
    <script is:inline>
        (function() {
            try {
                const stored = localStorage.getItem('cartItems');
                if (stored) {
                    const parsed = JSON.parse(stored);
                    if (Array.isArray(parsed)) {
                        const needsUpgrade = parsed.some(item => !item.hasOwnProperty('variant_id'));
                        if (needsUpgrade) {
                            localStorage.removeItem('cartItems');
                        }
                    }
                }
            } catch (e) {
                localStorage.removeItem('cartItems');
            }
        })();
    </script>

    <!-- Warm Luxury Hero Section -->
    <section class="bg-[#faf8f5] border-b border-stone-200/60 pt-20 pb-16 md:pt-28 md:pb-24 px-6 relative overflow-hidden">
        <div class="max-w-4xl mx-auto text-center flex flex-col items-center">
            
            <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-white border border-stone-200 shadow-2xs mb-6">
                <span class="w-1.5 h-1.5 rounded-full bg-stone-900"></span>
                <span class="text-[10px] font-mono uppercase tracking-[0.25em] text-stone-600 font-medium">Aju House Curation</span>
            </div>
            
            <h1 class="text-4xl sm:text-6xl md:text-7xl font-serif font-medium text-stone-900 mb-6 tracking-tight leading-[1.1]">
                Signature Scents. <br class="hidden sm:inline" />
                <span class="italic font-light text-stone-600">Modern Essentials.</span>
            </h1>
            
            <p class="text-sm sm:text-base text-stone-600 font-light max-w-lg mx-auto leading-relaxed mb-10">
                Hand-bottled artisanal perfumes and minimalist daily hardware. Crafted for tactile luxury and everyday performance.
            </p>
            
            <!-- Clean Primary Action Buttons -->
            <div class="flex flex-col sm:flex-row gap-3.5 w-full sm:w-auto">
                <a href="#shop" @click="window.location.hash = 'classic'" class="bg-black text-white px-8 py-4 text-[11px] font-bold uppercase tracking-[0.2em] hover:bg-stone-800 transition-all rounded-sm shadow-md text-center">
                    Shop Fragrances
                </a>
                <a href="#shop" @click="window.location.hash = 'accessories'" class="bg-white border border-stone-300 text-stone-900 px-8 py-4 text-[11px] font-bold uppercase tracking-[0.2em] hover:border-black transition-all rounded-sm text-center shadow-2xs">
                    Shop Accessories
                </a>
            </div>

        </div>

        <!-- Quick Collection Showcase Banner -->
        <div class="max-w-5xl mx-auto mt-16 md:mt-20 grid grid-cols-1 md:grid-cols-2 gap-5">
            
            <a href="#shop" @click="window.location.hash = 'classic'" class="group bg-white border border-stone-200 p-7 rounded-sm hover:border-stone-400 transition-all duration-300 shadow-2xs flex justify-between items-center">
                <div>
                    <span class="text-[9px] font-mono text-amber-700 tracking-widest uppercase font-semibold block mb-1">01 / Fine Scents</span>
                    <h3 class="font-serif text-xl text-stone-900 font-medium group-hover:translate-x-1 transition-transform">Artisanal Perfumery</h3>
                </div>
                <span class="w-9 h-9 rounded-full bg-stone-50 border border-stone-200 flex items-center justify-center text-stone-700 group-hover:bg-black group-hover:text-white transition-colors">→</span>
            </a>

            <a href="#shop" @click="window.location.hash = 'accessories'" class="group bg-white border border-stone-200 p-7 rounded-sm hover:border-stone-400 transition-all duration-300 shadow-2xs flex justify-between items-center">
                <div>
                    <span class="text-[9px] font-mono text-sky-700 tracking-widest uppercase font-semibold block mb-1">02 / Essentials</span>
                    <h3 class="font-serif text-xl text-stone-900 font-medium group-hover:translate-x-1 transition-transform">Tech & Accessories</h3>
                </div>
                <span class="w-9 h-9 rounded-full bg-stone-50 border border-stone-200 flex items-center justify-center text-stone-700 group-hover:bg-black group-hover:text-white transition-colors">→</span>
            </a>

        </div>
    </section>

    <!-- CURATED FEATURED SLIDER -->
    <section class="py-16 sm:py-20 bg-white border-b border-stone-100 overflow-hidden" 
             x-data="{
                scrollLeft() {
                    this.$refs.sliderContainer.scrollBy({ left: -320, behavior: 'smooth' });
                },
                scrollRight() {
                    const el = this.$refs.sliderContainer;
                    if (!el) return;
                    if (el.scrollLeft + el.clientWidth >= el.scrollWidth - 30) {
                        el.scrollTo({ left: 0, behavior: 'smooth' });
                    } else {
                        el.scrollBy({ left: 320, behavior: 'smooth' });
                    }
                }
             }">
        <div class="max-w-[1400px] mx-auto px-6 lg:px-12">
            
            <div class="flex justify-between items-end mb-8 sm:mb-10">
                <div>
                    <span class="text-[10px] text-stone-400 font-bold uppercase tracking-widest block mb-1">Curated List</span>
                    <h2 class="text-2xl sm:text-3xl font-serif font-medium tracking-tight text-stone-900">Featured Curations</h2>
                </div>
                
                <div class="flex gap-2">
                    <button @click="scrollLeft()" class="w-10 h-10 border border-stone-200 bg-white flex items-center justify-center text-stone-600 hover:text-black hover:border-black transition-colors rounded-sm shadow-2xs">
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M15 19l-7-7 7-7"></path></svg>
                    </button>
                    <button @click="scrollRight()" class="w-10 h-10 border border-stone-200 bg-white flex items-center justify-center text-stone-600 hover:text-black hover:border-black transition-colors rounded-sm shadow-2xs">
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 5l7 7-7 7"></path></svg>
                    </button>
                </div>
            </div>

            <!-- Horizontal Slider Container -->
            <div x-ref="sliderContainer" class="flex gap-6 overflow-x-auto no-scrollbar snap-x snap-mandatory scroll-smooth pb-4">
                {sliderProducts.map((product) => {
                    const rawCategory = product.category || 'Classic';
                    const categoryNormalized = rawCategory.toString().trim().charAt(0).toUpperCase() + rawCategory.toString().trim().slice(1).toLowerCase();
                    const isAccessory = categoryNormalized.toLowerCase().includes('access');
                    
                    const imageUrl = product.image_url ? String(product.image_url).split(',')[0].trim() : '';
                    const productName = product.name || 'Premium Item';
                    
                    const dbVariants = product.product_variants || [];
                    const hasVariants = dbVariants.length > 0;
                    
                    const defaultVariant = hasVariants ? dbVariants[0] : { id: null, variant_label: 'Standard', price_override: 0, stock_quantity: 0 };
                    const variantsJson = JSON.stringify(dbVariants).replace(/'/g, "\\'");
                    
                    const safeName = escapeAttr(productName);
                    const safeImageUrl = escapeAttr(imageUrl);

                    return (
                        <div class="snap-start w-[270px] sm:w-[290px] shrink-0 bg-white border border-stone-200/80 p-3.5 hover:border-stone-400 transition-all duration-300 flex flex-col justify-between group rounded-sm shadow-2xs"
                             x-data={`{
                                variants: ${variantsJson},
                                selectedVariantId: '${defaultVariant.id || ""}',
                                selectedLabel: '${defaultVariant.variant_label}',
                                currentPrice: ${defaultVariant.price_override || 0},
                                currentStock: ${defaultVariant.stock_quantity || 0},
                                updateVariant(vId) {
                                    const found = this.variants.find(v => v.id === vId);
                                    if (found) {
                                        this.selectedVariantId = found.id;
                                        this.selectedLabel = found.variant_label;
                                        this.currentPrice = found.price_override;
                                        this.currentStock = found.stock_quantity;
                                    }
                                }
                             }`}>
                            
                            <!-- Image Frame -->
                            <div class="aspect-[3/4] w-full bg-[#f7f6f3] relative mb-4 overflow-hidden flex items-center justify-center rounded-sm">
                                <a href={`/product/${product.id}`} class="absolute inset-0 z-10"></a>
                                
                                <span class={`absolute top-2.5 left-2.5 text-[8px] font-bold uppercase tracking-wider px-2 py-0.5 border z-20 rounded-2xs ${isAccessory ? 'bg-sky-50 text-sky-800 border-sky-100' : 'bg-amber-50 text-amber-800 border-amber-100'}`}>
                                    {isAccessory ? 'Accessory' : 'Fragrance'}
                                </span>

                                <span x-show="currentStock <= 0" class="absolute top-2.5 right-2.5 bg-red-600 text-white px-2 py-0.5 text-[8px] font-bold uppercase tracking-wider z-20 rounded-2xs">Sold Out</span>

                                {imageUrl ? (
                                    <img src={imageUrl} alt={productName} class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-103" />
                                ) : (
                                    <span class="text-stone-300 font-serif italic text-lg px-4 text-center">{productName.split(' ')[0]}</span>
                                )}
                            </div>

                            <!-- Details -->
                            <div class="text-left flex-grow flex flex-col justify-between">
                                <div>
                                    <a href={`/product/${product.id}`} class="block font-serif text-base font-medium text-stone-900 truncate hover:underline mb-1">
                                        {productName}
                                    </a>
                                    
                                    <!-- Variant Selector -->
                                    <template x-if="variants.length > 1">
                                        <div class="flex flex-wrap gap-1 my-2">
                                            <template x-for="v in variants" :key="v.id">
                                                <button 
                                                    type="button"
                                                    @click="updateVariant(v.id)"
                                                    :class="selectedVariantId === v.id ? 'bg-stone-900 text-white border-stone-900' : 'bg-white text-stone-600 border-stone-200 hover:border-stone-900'"
                                                    class="px-2 py-0.5 text-[8px] font-bold uppercase border rounded-2xs transition-all"
                                                    x-text="v.variant_label"
                                                ></button>
                                            </template>
                                        </div>
                                    </template>

                                    <template x-if="variants.length <= 1">
                                        <div class="text-[9px] font-mono text-stone-400 uppercase tracking-wider mb-2">
                                            <span x-text="selectedLabel"></span>
                                        </div>
                                    </template>
                                </div>

                                <div class="mt-3 pt-3 border-t border-stone-100 flex items-center justify-between gap-2">
                                    <span class="font-serif font-medium text-sm text-stone-900" x-text="'₹' + Number(currentPrice).toLocaleString('en-IN')"></span>

                                    <button 
                                        @click={`$store.cart.add({ id: '${product.id}', variant_id: selectedVariantId, name: '${safeName}', price: currentPrice, volume: selectedLabel, image_url: '${safeImageUrl}' })`}
                                        :disabled="currentStock <= 0"
                                        class="px-3.5 py-1.5 uppercase text-[9px] font-bold tracking-wider rounded-2xs transition-colors border"
                                        :class="currentStock <= 0 ? 'bg-stone-50 text-stone-300 border-stone-200 cursor-not-allowed' : 'bg-black text-white border-black hover:bg-stone-800'"
                                    >
                                        <span x-show="currentStock <= 0">Out</span>
                                        <span x-show="currentStock > 0">+ Add</span>
                                    </button>
                                </div>
                            </div>
                        </div>
                    );
                })}
            </div>
        </div>
    </section>

    <!-- FULL CATALOG SECTION -->
    <section id="shop" class="py-16 sm:py-24 px-6 max-w-[1400px] mx-auto" 
             x-data={sectionXData} 
             x-init="
                const updateFilter = () => {
                    const hash = window.location.hash.substring(1).toLowerCase().trim();
                    if (!hash || hash === 'shop' || hash === 'all') {
                        filter = 'All';
                        return;
                    }
                    
                    const matchedCat = categories.find(cat => cat.toLowerCase().trim() === hash);
                    if (matchedCat) {
                        filter = matchedCat;
                    } else if (hash === 'fragrances') {
                        filter = 'Classic';
                    } else if (hash === 'accessories') {
                        filter = 'Accessories';
                    } else {
                        filter = 'All';
                    }
                };
                updateFilter();
                window.addEventListener('hashchange', updateFilter);
             ">
        
        <div class="flex flex-col md:flex-row justify-between items-start md:items-end mb-10 border-b border-stone-200 pb-6 gap-6">
            <div>
                <span class="text-[10px] text-stone-400 font-bold uppercase tracking-widest block mb-1">Explore All</span>
                <h2 class="text-3xl sm:text-4xl font-serif font-medium text-stone-900">All Collections</h2>
            </div>
            
            <!-- Category Tabs -->
            <div class="flex flex-wrap gap-2 text-xs font-medium">
                <button @click="filter = 'All'; window.location.hash = 'shop'" 
                        :class="filter === 'All' ? 'bg-black text-white' : 'bg-stone-100 text-stone-600 hover:bg-stone-200'" 
                        class="px-4 py-2 rounded-full uppercase text-[10px] tracking-wider transition-colors">
                    All Items
                </button>
                
                {rawCategories.map(cat => (
                    <button @click={`filter = '${cat}'; window.location.hash = '${cat.toLowerCase()}'`} 
                            :class={`filter === '${cat}' ? 'bg-black text-white' : 'bg-stone-100 text-stone-600 hover:bg-stone-200'`} 
                            class="px-4 py-2 rounded-full uppercase text-[10px] tracking-wider transition-colors">
                        {cat === 'Accessories' ? 'Tech & Accessories' : (cat + ' Perfumes')}
                    </button>
                ))}
            </div>
        </div>

        <div class="grid grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-x-5 gap-y-10">
            
            {(products || []).map((product) => {
                const rawCategory = product.category || 'Classic';
                const categoryNormalized = rawCategory.toString().trim().charAt(0).toUpperCase() + rawCategory.toString().trim().slice(1).toLowerCase();
                const isAccessory = categoryNormalized.toLowerCase().includes('access');
                
                const imageUrl = product.image_url ? String(product.image_url).split(',')[0].trim() : '';
                const productName = product.name || 'Premium Item';
                
                const dbVariants = product.product_variants || [];
                const hasVariants = dbVariants.length > 0;
                
                const defaultVariant = hasVariants ? dbVariants[0] : { id: null, variant_label: 'Standard', price_override: 0, stock_quantity: 0 };
                const variantsJson = JSON.stringify(dbVariants).replace(/'/g, "\\'");

                let xShow = `filter === 'All' || filter === '${categoryNormalized}' || (filter === 'Fragrances' && ('${categoryNormalized}' === 'Classic' || '${categoryNormalized}' === 'Premium'))`;

                const safeName = escapeAttr(productName);
                const safeImageUrl = escapeAttr(imageUrl);
                
                return (
                    <div 
                        class="group flex flex-col bg-white border border-stone-200/70 hover:border-stone-400 p-3.5 transition-all duration-300 rounded-sm shadow-2xs"
                        x-show={xShow}
                        x-data={`{
                            variants: ${variantsJson},
                            selectedVariantId: '${defaultVariant.id || ""}',
                            selectedLabel: '${defaultVariant.variant_label}',
                            currentPrice: ${defaultVariant.price_override || 0},
                            currentStock: ${defaultVariant.stock_quantity || 0},
                            updateVariant(vId) {
                                const found = this.variants.find(v => v.id === vId);
                                if (found) {
                                    this.selectedVariantId = found.id;
                                    this.selectedLabel = found.variant_label;
                                    this.currentPrice = found.price_override;
                                    this.currentStock = found.stock_quantity;
                                }
                            }
                        }`}
                        x-transition:enter="transition-opacity duration-300"
                        x-transition:enter-start="opacity-0"
                        x-transition:enter-end="opacity-100"
                    >
                        <!-- Image Container -->
                        <div class="aspect-[3/4] w-full bg-[#f7f6f3] relative mb-4 overflow-hidden flex items-center justify-center rounded-sm">
                            <a href={`/product/${product.id}`} class="absolute inset-0 z-10"></a>

                            <span class={`absolute top-2.5 left-2.5 text-[8px] font-bold uppercase tracking-wider px-2 py-0.5 border z-20 rounded-2xs ${isAccessory ? 'bg-sky-50 text-sky-800 border-sky-100' : 'bg-amber-50 text-amber-800 border-amber-100'}`}>
                                {isAccessory ? 'Accessory' : 'Fragrance'}
                            </span>

                            <span x-show="currentStock <= 0" class="absolute top-2.5 right-2.5 bg-red-600 text-white px-2 py-0.5 text-[8px] font-bold uppercase tracking-wider z-20 rounded-2xs">Sold Out</span>

                            {imageUrl ? (
                                <img 
                                    src={imageUrl} 
                                    alt={productName} 
                                    class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-103"
                                    onerror="this.style.display='none'; this.nextElementSibling.style.display='block';"
                                />
                            ) : null}
                            
                            <span class={`font-serif italic text-2xl text-stone-300 px-4 text-center ${imageUrl ? 'hidden' : 'block'}`}>
                                {productName.split(' ')[0]}
                            </span>
                        </div>

                        <!-- Product Metadata -->
                        <div class="flex-grow flex flex-col justify-between">
                            <div>
                                <a href={`/product/${product.id}`} class="block font-serif text-base sm:text-lg font-medium text-stone-900 mb-1 hover:underline truncate">
                                    {productName}
                                </a>
                                
                                <!-- Variant Selector -->
                                <template x-if="variants.length > 1">
                                    <div class="flex flex-wrap gap-1 my-2">
                                        <template x-for="v in variants" :key="v.id">
                                            <button 
                                                type="button"
                                                @click="updateVariant(v.id)"
                                                :class="selectedVariantId === v.id ? 'bg-stone-900 text-white border-stone-900' : 'bg-white text-stone-600 border-stone-200 hover:border-stone-900'"
                                                class="px-2 py-0.5 text-[8px] font-bold uppercase border rounded-2xs transition-all"
                                                x-text="v.variant_label"
                                            ></button>
                                        </template>
                                    </div>
                                </template>

                                <template x-if="variants.length <= 1">
                                    <div class="text-[9px] font-mono text-stone-400 uppercase tracking-wider mb-2">
                                        <span x-text="selectedLabel"></span>
                                    </div>
                                </template>
                            </div>
                            
                            <!-- Bottom Row -->
                            <div class="mt-3 pt-3 border-t border-stone-100 flex items-center justify-between gap-2">
                                <span class="font-serif font-medium text-base text-stone-900" x-text="'₹' + Number(currentPrice).toLocaleString('en-IN')"></span>

                                <button 
                                    @click={`$store.cart.add({ id: '${product.id}', variant_id: selectedVariantId, name: '${safeName}', price: currentPrice, volume: selectedLabel, image_url: '${safeImageUrl}' })`}
                                    :disabled="currentStock <= 0"
                                    class="px-3.5 py-1.5 uppercase text-[9px] font-bold tracking-wider rounded-2xs transition-colors border"
                                    :class="currentStock <= 0 ? 'bg-stone-50 text-stone-300 border-stone-200 cursor-not-allowed' : 'bg-black text-white border-black hover:bg-stone-800'"
                                >
                                    <span x-show="currentStock <= 0">Out</span>
                                    <span x-show="currentStock > 0">+ Add</span>
                                </button>
                            </div>
                        </div>
                    </div>
                );
            })}
            
            <!-- Empty State -->
            <div x-show="!categories.some(cat => filter === 'All' || (filter === 'Fragrances' && (cat === 'Classic' || cat === 'Premium')) || cat === filter)" style="display: none;" class="col-span-full py-16 text-center text-stone-400 font-serif italic text-base">
                No items currently found in this category.
            </div>

        </div>
    </section>

</Layout>
---
import Layout from '../layouts/Layout.astro';
import { supabase } from '../lib/supabase.js';

// Securely pull Products alongside their nested product_variants relational array
const { data: products, error } = await supabase
  .from('products')
  .select('*, product_variants(*)')
  .order('created_at', { ascending: false });

if (error) console.error('Error fetching inventory catalog:', error.message);

// Dynamically generate unique categories sorted alphabetically
const rawCategories = Array.from(new Set((products || []).map(p => {
    const cat = (p.category || 'Classic').trim();
    return cat.charAt(0).toUpperCase() + cat.slice(1).toLowerCase();
}))).sort();

const categoryList = rawCategories.map(c => `'${c}'`).join(', ');
const sectionXData = `{ filter: 'All', categories: [${categoryList}] }`;

// Select top 6 products as featured gallery sliding entries
const sliderProducts = (products || []).slice(0, 6);

const escapeAttr = (str) => {
    if (!str) return '';
    return String(str).replace(/'/g, "\\'").replace(/"/g, "&quot;");
};
---

<Layout title="Aju | Fine Fragrances & Modern Tech Accessories">
    
    <!-- Self-Healing Local Storage Script for returning browsers -->
    <script is:inline>
        (function() {
            try {
                const stored = localStorage.getItem('cartItems');
                if (stored) {
                    const parsed = JSON.parse(stored);
                    if (Array.isArray(parsed)) {
                        // Upgrade Cart schema to support database variation UUIDs
                        const needsUpgrade = parsed.some(item => !item.hasOwnProperty('variant_id'));
                        if (needsUpgrade) {
                            console.log('Upgrading browser storage cart elements to Variant schema v2...');
                            localStorage.removeItem('cartItems');
                        }
                    }
                }
            } catch (e) {
                localStorage.removeItem('cartItems');
            }
        })();
    </script>

    <!-- Unified Dual-Collection Lifestyle Hero Section -->
    <section class="relative min-h-[85vh] lg:min-h-[90vh] flex flex-col justify-center items-center overflow-hidden bg-[#0a0a0a] pt-16 pb-16">
        <!-- Ambient Background Glows -->
        <div class="absolute inset-0 pointer-events-none">
            <div class="absolute top-[-20%] left-[-10%] w-[50%] h-[50%] rounded-full bg-neutral-800 blur-[130px] opacity-40"></div>
            <div class="absolute bottom-[-20%] right-[-10%] w-[50%] h-[50%] rounded-full bg-stone-800 blur-[130px] opacity-30"></div>
        </div>
        
        <div class="relative z-10 text-center px-6 max-w-5xl mx-auto flex flex-col items-center">
            <!-- Subhead Badge -->
            <div class="flex items-center gap-2 mb-8 border border-white/20 px-5 py-2 rounded-full backdrop-blur-md">
                <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
                <span class="text-white/80 uppercase tracking-[0.3em] text-[10px] font-bold">Two Houses • One Aesthetic</span>
            </div>
            
            <!-- Main Hero Headline -->
            <h1 class="text-4xl sm:text-6xl lg:text-[5.5rem] text-white font-serif mb-6 leading-[1.1] font-medium tracking-tight">
                Fine Fragrances. <br>
                <span class="italic font-light text-gray-300">Modern Essentials.</span>
            </h1>
            
            <p class="text-sm sm:text-base md:text-lg text-gray-400 mb-10 font-light max-w-2xl leading-relaxed mx-auto">
                Explore hand-bottled artisanal perfumes alongside minimal, high-durability mobile accessories. Crafted for tactile luxury and everyday performance.
            </p>
            
            <!-- Dual Action CTAs -->
            <div class="flex flex-col sm:flex-row gap-4 w-full sm:w-auto">
                <a href="#shop" @click="window.location.hash = 'classic'" class="bg-white text-black px-10 py-4 uppercase text-[11px] font-bold tracking-[0.2em] hover:bg-gray-200 transition-all duration-300 rounded-sm shadow-xl text-center">
                    Shop Fragrances
                </a>
                <a href="#shop" @click="window.location.hash = 'accessories'" class="border border-white/30 text-white hover:bg-white/10 px-10 py-4 uppercase text-[11px] font-bold tracking-[0.2em] transition-all duration-300 rounded-sm backdrop-blur-sm text-center">
                    Shop Tech & Accessories
                </a>
            </div>
        </div>

        <!-- House Department Quick Cards -->
        <div class="relative z-10 max-w-[1200px] w-full mx-auto px-6 mt-16 md:mt-20 grid grid-cols-1 md:grid-cols-2 gap-6">
            
            <!-- Department 1: Scents -->
            <a href="#shop" @click="window.location.hash = 'classic'" class="group bg-gradient-to-br from-neutral-900/90 to-neutral-950/90 border border-neutral-800 p-8 rounded-sm hover:border-neutral-600 transition-all duration-500 backdrop-blur-md flex justify-between items-end">
                <div>
                    <span class="text-[9px] text-amber-500 font-bold uppercase tracking-[0.25em] block mb-2">Department 01</span>
                    <h3 class="font-serif text-2xl text-white font-medium group-hover:translate-x-1 transition-transform">Artisanal Perfumery</h3>
                    <p class="text-xs text-neutral-400 font-light mt-1">Extracts, Eaux de Parfum & Olfactory Objects</p>
                </div>
                <span class="text-white text-lg font-serif italic group-hover:translate-x-2 transition-transform">Explore →</span>
            </a>

            <!-- Department 2: Accessories -->
            <a href="#shop" @click="window.location.hash = 'accessories'" class="group bg-gradient-to-br from-neutral-900/90 to-neutral-950/90 border border-neutral-800 p-8 rounded-sm hover:border-neutral-600 transition-all duration-500 backdrop-blur-md flex justify-between items-end">
                <div>
                    <span class="text-[9px] text-sky-400 font-bold uppercase tracking-[0.25em] block mb-2">Department 02</span>
                    <h3 class="font-serif text-2xl text-white font-medium group-hover:translate-x-1 transition-transform">Tech & Essentials</h3>
                    <p class="text-xs text-neutral-400 font-light mt-1">Durable Mobile Cases, Chargers & Daily Hardware</p>
                </div>
                <span class="text-white text-lg font-serif italic group-hover:translate-x-2 transition-transform">Explore →</span>
            </a>

        </div>
    </section>

    <!-- CURATED MANUAL SLIDER GALLERY -->
    <section class="py-20 sm:py-28 bg-[#fafafa] border-b border-gray-100 overflow-hidden" 
             x-data="{
                scrollLeft() {
                    this.$refs.sliderContainer.scrollBy({ left: -320, behavior: 'smooth' });
                },
                scrollRight() {
                    const el = this.$refs.sliderContainer;
                    if (!el) return;
                    if (el.scrollLeft + el.clientWidth >= el.scrollWidth - 30) {
                        el.scrollTo({ left: 0, behavior: 'smooth' });
                    } else {
                        el.scrollBy({ left: 320, behavior: 'smooth' });
                    }
                }
             }">
        <div class="max-w-[1400px] mx-auto px-6 lg:px-12">
            
            <div class="flex justify-between items-end mb-12 sm:mb-16">
                <div>
                    <span class="text-[10px] text-gray-400 font-bold uppercase tracking-widest block mb-2">House Selection</span>
                    <h2 class="text-3xl sm:text-4xl font-serif font-medium tracking-tight text-gray-900">Featured Curations</h2>
                </div>
                
                <!-- Navigation Controls -->
                <div class="flex gap-4">
                    <button @click="scrollLeft()" class="w-12 h-12 rounded-full border border-gray-200 bg-white flex items-center justify-center text-gray-600 hover:text-black hover:border-black active:scale-95 transition-all shadow-sm focus:outline-none">
                        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M15 19l-7-7 7-7"></path></svg>
                    </button>
                    <button @click="scrollRight()" class="w-12 h-12 rounded-full border border-gray-200 bg-white flex items-center justify-center text-gray-600 hover:text-black hover:border-black active:scale-95 transition-all shadow-sm focus:outline-none">
                        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 5l7 7-7 7"></path></svg>
                    </button>
                </div>
            </div>

            <!-- Dynamic Horizontal Sliding Container -->
            <div x-ref="sliderContainer" class="flex gap-6 sm:gap-8 overflow-x-auto no-scrollbar snap-x snap-mandatory scroll-smooth pb-8">
                {sliderProducts.map((product) => {
                    const rawCategory = product.category || 'Classic';
                    const categoryNormalized = rawCategory.toString().trim().charAt(0).toUpperCase() + rawCategory.toString().trim().slice(1).toLowerCase();
                    const isAccessory = categoryNormalized.toLowerCase().includes('access');
                    
                    const imageUrl = product.image_url ? String(product.image_url).split(',')[0].trim() : '';
                    const productName = product.name || 'Premium Item';
                    
                    const dbVariants = product.product_variants || [];
                    const hasVariants = dbVariants.length > 0;
                    
                    const defaultVariant = hasVariants ? dbVariants[0] : { id: null, variant_label: 'Standard', price_override: 0, stock_quantity: 0 };
                    const variantsJson = JSON.stringify(dbVariants).replace(/'/g, "\\'");
                    
                    const safeName = escapeAttr(productName);
                    const safeImageUrl = escapeAttr(imageUrl);

                    return (
                        <div class="snap-start w-[280px] sm:w-[320px] shrink-0 bg-white border border-gray-100 rounded-lg p-3 hover:shadow-xl hover:shadow-gray-200/50 transition-all duration-300 flex flex-col justify-between group"
                             x-data={`{
                                variants: ${variantsJson},
                                selectedVariantId: '${defaultVariant.id || ""}',
                                selectedLabel: '${defaultVariant.variant_label}',
                                currentPrice: ${defaultVariant.price_override || 0},
                                currentStock: ${defaultVariant.stock_quantity || 0},
                                updateVariant(vId) {
                                    const found = this.variants.find(v => v.id === vId);
                                    if (found) {
                                        this.selectedVariantId = found.id;
                                        this.selectedLabel = found.variant_label;
                                        this.currentPrice = found.price_override;
                                        this.currentStock = found.stock_quantity;
                                    }
                                }
                             }`}>
                            
                            <!-- Image Area -->
                            <div class="aspect-[3/4] w-full bg-[#fcfcfc] rounded-md relative mb-6 overflow-hidden flex items-center justify-center">
                                <!-- Invisible Click Overlay for Image -->
                                <a href={`/product/${product.id}`} class="absolute inset-0 z-10"></a>
                                
                                <span class={`absolute top-3 left-3 px-2.5 py-1 text-[8px] font-bold uppercase tracking-widest z-20 rounded-xs border ${isAccessory ? 'bg-sky-50 text-sky-800 border-sky-100' : 'bg-amber-50 text-amber-800 border-amber-100'}`}>
                                    {isAccessory ? 'Accessory' : 'Fragrance'}
                                </span>

                                <span x-show="currentStock <= 0" class="absolute top-3 right-3 bg-red-600 text-white px-2.5 py-1 text-[8px] font-bold uppercase tracking-widest z-20 shadow-sm rounded-sm">Out of Stock</span>

                                {imageUrl ? (
                                    <img src={imageUrl} alt={productName} class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105" />
                                ) : (
                                    <span class="text-gray-300 font-serif italic text-xl px-4 text-center">{productName.split(' ')[0]}</span>
                                )}
                            </div>

                            <!-- Details & Selectors -->
                            <div class="text-center flex-grow flex flex-col justify-between relative z-20">
                                <div>
                                    <a href={`/product/${product.id}`} class="block font-serif text-base sm:text-lg font-medium text-gray-900 truncate mb-1 hover:underline">
                                        {productName}
                                    </a>
                                    
                                    <!-- PILL SELECTOR FOR VARIANTS -->
                                    <template x-if="variants.length > 1">
                                        <div class="flex flex-wrap gap-1.5 justify-center my-3">
                                            <template x-for="v in variants" :key="v.id">
                                                <button 
                                                    type="button"
                                                    @click="updateVariant(v.id)"
                                                    :class="selectedVariantId === v.id ? 'bg-black text-white border-black' : 'bg-white text-gray-500 border-gray-200 hover:border-black'"
                                                    class="px-3 py-1.5 text-[8px] font-bold uppercase tracking-wider border rounded-sm transition-all focus:outline-none"
                                                    x-text="v.variant_label"
                                                ></button>
                                            </template>
                                        </div>
                                    </template>

                                    <template x-if="variants.length <= 1">
                                        <div class="text-[8px] sm:text-[9px] text-gray-500 uppercase tracking-widest my-3 font-bold">
                                            <span x-text="selectedLabel"></span>
                                            <span class="text-gray-300 mx-1">•</span>
                                            <span>{categoryNormalized}</span>
                                        </div>
                                    </template>
                                </div>

                                <div class="space-y-2 mt-3">
                                    <button 
                                        @click={`$store.cart.add({ id: '${product.id}', variant_id: selectedVariantId, name: '${safeName}', price: currentPrice, volume: selectedLabel, image_url: '${safeImageUrl}' })`}
                                        :disabled="currentStock <= 0"
                                        class="w-full py-3 uppercase text-[9px] sm:text-[10px] font-bold tracking-[0.2em] rounded-sm transition-colors"
                                        :class="currentStock <= 0 ? 'bg-gray-100 text-gray-400 cursor-not-allowed border border-gray-200' : 'bg-black text-white hover:bg-neutral-800'"
                                    >
                                        <span x-show="currentStock <= 0">Sold Out</span>
                                        <span x-show="currentStock > 0" x-text="'Add — ₹' + Number(currentPrice).toLocaleString('en-IN')">
                                            Add — ₹{defaultVariant.price_override.toLocaleString('en-IN')}
                                        </span>
                                    </button>

                                    <a href={`/product/${product.id}`} class="block text-center text-[9px] uppercase font-bold tracking-widest text-gray-400 hover:text-black transition-colors pt-1">
                                        View Full Specs & Photos →
                                    </a>
                                </div>
                            </div>
                        </div>
                    );
                })}
            </div>
            
            <p class="text-center text-[10px] text-gray-400 uppercase tracking-widest font-semibold mt-4">Swipe left / right to browse items</p>
        </div>
    </section>

    <!-- FULL GRID CATALOG SECTION WITH FILTERING -->
    <section id="shop" class="py-24 sm:py-32 px-4 sm:px-6 lg:px-12 max-w-[1400px] mx-auto" 
             x-data={sectionXData} 
             x-init="
                const updateFilter = () => {
                    const hash = window.location.hash.substring(1).toLowerCase().trim();
                    if (!hash || hash === 'shop' || hash === 'all') {
                        filter = 'All';
                        return;
                    }
                    
                    const matchedCat = categories.find(cat => cat.toLowerCase().trim() === hash);
                    if (matchedCat) {
                        filter = matchedCat;
                    } else if (hash === 'fragrances') {
                        filter = 'Classic';
                    } else if (hash === 'accessories') {
                        filter = 'Accessories';
                    } else {
                        filter = 'All';
                    }
                };
                updateFilter();
                window.addEventListener('hashchange', updateFilter);
             ">
        
        <div class="flex flex-col md:flex-row justify-between items-center md:items-end mb-12 sm:mb-20 border-b border-gray-200 pb-8 gap-6 sm:gap-8">
            <div>
                <span class="text-[10px] text-gray-400 font-bold uppercase tracking-widest block mb-2">Master Catalog</span>
                <h2 class="text-3xl sm:text-4xl md:text-5xl font-serif font-medium tracking-tight text-gray-900 text-center md:text-left">All Objects</h2>
            </div>
            
            <!-- Category Tabs -->
            <div class="flex flex-wrap gap-3 justify-center sm:gap-8">
                <button @click="filter = 'All'; window.location.hash = 'shop'" 
                        :class="filter === 'All' ? 'text-black border-b-2 border-black font-bold' : 'text-gray-400 border-transparent hover:text-black'" 
                        class="pb-1 uppercase text-[10px] sm:text-[11px] tracking-[0.2em] transition-colors">
                    All Categories
                </button>
                
                {rawCategories.map(cat => (
                    <button @click={`filter = '${cat}'; window.location.hash = '${cat.toLowerCase()}'`} 
                            :class={`filter === '${cat}' ? 'text-black border-b-2 border-black font-bold' : 'text-gray-400 border-transparent hover:text-black'`} 
                            class="pb-1 uppercase text-[10px] sm:text-[11px] tracking-[0.2em] transition-colors">
                        {cat === 'Accessories' ? 'Tech & Accessories' : (cat + ' Scents')}
                    </button>
                ))}
            </div>
        </div>

        <div class="grid grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-x-4 sm:gap-x-12 gap-y-12 sm:gap-y-24">
            
            {(products || []).map((product) => {
                const rawCategory = product.category || 'Classic';
                const categoryNormalized = rawCategory.toString().trim().charAt(0).toUpperCase() + rawCategory.toString().trim().slice(1).toLowerCase();
                const isAccessory = categoryNormalized.toLowerCase().includes('access');
                
                const imageUrl = product.image_url ? String(product.image_url).split(',')[0].trim() : '';
                const productName = product.name || 'Premium Item';
                
                const dbVariants = product.product_variants || [];
                const hasVariants = dbVariants.length > 0;
                
                const defaultVariant = hasVariants ? dbVariants[0] : { id: null, variant_label: 'Standard', price_override: 0, stock_quantity: 0 };
                const variantsJson = JSON.stringify(dbVariants).replace(/'/g, "\\'");

                let xShow = `filter === 'All' || filter === '${categoryNormalized}' || (filter === 'Fragrances' && ('${categoryNormalized}' === 'Classic' || '${categoryNormalized}' === 'Premium'))`;

                const safeName = escapeAttr(productName);
                const safeImageUrl = escapeAttr(imageUrl);
                
                return (
                    <div 
                        class="group flex flex-col bg-white p-2 rounded-sm border border-transparent hover:border-gray-100 transition-all duration-300"
                        x-show={xShow}
                        x-data={`{
                            variants: ${variantsJson},
                            selectedVariantId: '${defaultVariant.id || ""}',
                            selectedLabel: '${defaultVariant.variant_label}',
                            currentPrice: ${defaultVariant.price_override || 0},
                            currentStock: ${defaultVariant.stock_quantity || 0},
                            updateVariant(vId) {
                                const found = this.variants.find(v => v.id === vId);
                                if (found) {
                                    this.selectedVariantId = found.id;
                                    this.selectedLabel = found.variant_label;
                                    this.currentPrice = found.price_override;
                                    this.currentStock = found.stock_quantity;
                                }
                            }
                        }`}
                        x-transition:enter="transition-opacity duration-500 ease-out"
                        x-transition:enter-start="opacity-0 translate-y-4"
                        x-transition:enter-end="opacity-100 translate-y-0"
                    >
                        <!-- Image Container -->
                        <div class="aspect-[3/4] w-full bg-[#f4f4f4] relative mb-4 sm:mb-8 overflow-hidden flex items-center justify-center transition-colors duration-500 group-hover:bg-[#ebebeb]">
                            
                            <!-- Invisible Click Overlay for Image -->
                            <a href={`/product/${product.id}`} class="absolute inset-0 z-10"></a>

                            <span class={`absolute top-3 left-3 px-2 py-0.5 text-[7px] sm:text-[8px] font-bold uppercase tracking-widest z-20 rounded-xs border ${isAccessory ? 'bg-sky-50 text-sky-800 border-sky-100' : 'bg-amber-50 text-amber-800 border-amber-100'}`}>
                                {isAccessory ? 'Accessory' : 'Fragrance'}
                            </span>

                            <span x-show="currentStock <= 0" class="absolute top-4 right-4 bg-red-600 text-white px-3 py-1 text-[8px] font-bold uppercase tracking-widest z-20 shadow-sm rounded-sm">Out of Stock</span>

                            {imageUrl ? (
                                <>
                                    <img 
                                        src={imageUrl} 
                                        alt={productName} 
                                        class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105"
                                        onerror="this.style.display='none'; this.nextElementSibling.style.display='block';"
                                    />
                                    <span class="hidden text-gray-400 font-serif italic text-xl sm:text-3xl px-4 text-center transition-transform duration-700 group-hover:scale-105">
                                        {productName.split(' ')[0]}
                                    </span>
                                </>
                            ) : (
                                <span class="text-gray-400 font-serif italic text-xl sm:text-3xl px-4 text-center transition-transform duration-700 group-hover:scale-105">
                                    {productName.split(' ')[0]}
                                </span>
                            )}
                            
                            <!-- Quick Add Overlay button for Desktop -->
                            <div class="hidden lg:block absolute inset-x-0 bottom-0 p-6 translate-y-full group-hover:translate-y-0 transition-transform duration-500 ease-[cubic-bezier(0.16,1,0.3,1)] z-30">
                                <button 
                                    @click={`$store.cart.add({ id: '${product.id}', variant_id: selectedVariantId, name: '${safeName}', price: currentPrice, volume: selectedLabel, image_url: '${safeImageUrl}' })`}
                                    :disabled="currentStock <= 0"
                                    class="w-full py-4 uppercase text-[10px] font-bold tracking-[0.2em] transition-colors duration-300 shadow-xl"
                                    :class="currentStock <= 0 ? 'bg-gray-200 text-gray-400 cursor-not-allowed' : 'bg-white text-black hover:bg-black hover:text-white'"
                                >
                                    <span x-show="currentStock <= 0">Sold Out</span>
                                    <span x-show="currentStock > 0" x-text="'Quick Add — ₹' + Number(currentPrice).toLocaleString('en-IN')">
                                        Quick Add — ₹{defaultVariant.price_override.toLocaleString('en-IN')}
                                    </span>
                                </button>
                            </div>
                        </div>

                        <!-- Product Metadata -->
                        <div class="text-center px-1 sm:px-2 flex-grow flex flex-col justify-between relative z-20">
                            <div>
                                <a href={`/product/${product.id}`} class="block font-serif text-base sm:text-xl font-medium text-gray-900 mb-1 sm:mb-2 leading-tight hover:underline">
                                    {productName}
                                </a>
                                
                                <!-- PILL SELECTORS FOR PRODUCT LISTING -->
                                <template x-if="variants.length > 1">
                                    <div class="flex flex-wrap gap-1.5 justify-center my-3 relative z-30">
                                        <template x-for="v in variants" :key="v.id">
                                            <button 
                                                type="button"
                                                @click="updateVariant(v.id)"
                                                :class="selectedVariantId === v.id ? 'bg-black text-white border-black' : 'bg-white text-gray-500 border-gray-200 hover:border-black'"
                                                class="px-2.5 py-1 text-[8px] font-bold uppercase tracking-wider border rounded-sm transition-all focus:outline-none"
                                                x-text="v.variant_label"
                                            ></button>
                                        </template>
                                    </div>
                                </template>

                                <template x-if="variants.length <= 1">
                                    <div class="flex items-center justify-center gap-1 sm:gap-2 text-[8px] sm:text-[9px] text-gray-500 uppercase tracking-[0.2em] mb-2 sm:mb-4 font-bold">
                                        <span x-text="selectedLabel"></span>
                                        <span class="text-gray-300">•</span>
                                        <span>{categoryNormalized}</span>
                                    </div>
                                </template>
                                
                                {product.notes && (
                                    <p class="text-xs sm:text-sm text-gray-500 font-light leading-relaxed line-clamp-2 mb-4 sm:mb-6 max-w-[280px] mx-auto hidden sm:block">
                                        {product.notes}
                                    </p>
                                )}
                            </div>
                            
                            <!-- Mobile Action Buttons -->
                            <div class="mt-2 space-y-1.5 lg:hidden relative z-30">
                                <button 
                                    @click={`$store.cart.add({ id: '${product.id}', variant_id: selectedVariantId, name: '${safeName}', price: currentPrice, volume: selectedLabel, image_url: '${safeImageUrl}' })`}
                                    :disabled="currentStock <= 0"
                                    class="w-full border py-2.5 sm:py-3 uppercase text-[9px] sm:text-[10px] font-bold tracking-[0.2em] transition-colors"
                                    :class="currentStock <= 0 ? 'border-gray-100 bg-gray-50 text-gray-400 cursor-not-allowed' : 'border-gray-200 text-gray-900 hover:bg-gray-50'"
                                >
                                    <span x-show="currentStock <= 0">Sold Out</span>
                                    <span x-show="currentStock > 0" x-text="'Add to Bag — ₹' + Number(currentPrice).toLocaleString('en-IN')">
                                        Add to Bag — ₹{defaultVariant.price_override.toLocaleString('en-IN')}
                                    </span>
                                </button>
                                <a href={`/product/${product.id}`} class="block text-center text-[9px] uppercase font-bold tracking-widest text-gray-400 hover:text-black py-1">
                                    View Details →
                                </a>
                            </div>
                        </div>
                    </div>
                );
            })}
            
            <!-- Empty State -->
            <div x-show="!categories.some(cat => filter === 'All' || (filter === 'Fragrances' && (cat === 'Classic' || cat === 'Premium')) || cat === filter)" style="display: none;" class="col-span-full py-12 text-center text-gray-400 font-serif italic text-lg">
                No products found in this collection.
            </div>

        </div>
    </section>

</Layout>